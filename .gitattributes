# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF
*.sh text eol=lf

# Windows scripts must use CRLF (if any)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper scripts are auto-generated by `./gradlew wrapper`. Store as-is to
# avoid clean-filter mismatches with tools that commit bytes directly (e.g. Dependabot).
gradlew     -text
gradlew.bat -text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.jar binary
*.war binary
