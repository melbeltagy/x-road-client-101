{
  "name": "x-road-example-restapi-client",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "X-Road Generic REST API Client",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf build/resources/main/static/ && webpack --config webpack/webpack.dev.js",
    "build:prod": "rimraf build/resources/main/static/ && webpack --config webpack/webpack.prod.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "start": "webpack serve --config webpack/webpack.dev.js",
    "test": "jest --coverage --logHeapUsage --maxWorkers=2 --config jest.conf.js",
    "test:watch": "jest --watch --config jest.conf.js",
    "webapp:build": "npm run build",
    "webapp:prod": "npm run build:prod",
    "webapp:test": "npm run lint && npm run test"
  },
  "overrides": {
    "browser-sync": "3.0.4",
    "react-redux-loading-bar": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "7.1.0",
    "@fortawesome/react-fontawesome": "3.1.1",
    "@reduxjs/toolkit": "2.11.2",
    "axios": "^1.13.2",
    "bootstrap": "5.3.8",
    "bootswatch": "5.3.8",
    "dayjs": "1.11.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.70.0",
    "react-json-view-lite": "2.5.0",
    "react-redux": "9.2.0",
    "react-redux-loading-bar": "5.0.8",
    "react-router": "7.11.0",
    "react-router-dom": "7.11.0",
    "react-toastify": "11.0.5",
    "reactstrap": "9.2.3",
    "redux": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/react": "16.3.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-redux": "7.1.34",
    "@types/redux": "3.6.31",
    "@types/webpack-env": "1.18.8",
    "autoprefixer": "10.4.23",
    "browser-sync": "3.0.4",
    "browser-sync-webpack-plugin": "2.4.0",
    "copy-webpack-plugin": "13.0.1",
    "core-js": "3.47.0",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "7.0.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-webpack-plugin": "5.0.2",
    "folder-hash": "4.1.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "html-webpack-plugin": "5.6.5",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-fixed-jsdom": "0.0.11",
    "jest-junit": "16.0.0",
    "jest-sonar": "0.2.16",
    "lint-staged": "16.2.7",
    "merge-jsons-webpack-plugin": "2.0.1",
    "mini-css-extract-plugin": "2.9.4",
    "path-browserify": "1.0.1",
    "postcss-loader": "8.2.0",
    "prettier": "3.7.4",
    "prettier-plugin-java": "2.7.7",
    "prettier-plugin-packagejson": "2.5.20",
    "redux-mock-store": "1.5.5",
    "rimraf": "6.1.2",
    "sass": "1.97.1",
    "sass-loader": "16.0.6",
    "simple-progress-webpack-plugin": "2.0.0",
    "sinon": "21.0.1",
    "source-map-loader": "5.0.0",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.3.16",
    "thread-loader": "4.0.4",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2",
    "webpack-merge": "6.0.1",
    "webpack-notifier": "1.15.0",
    "workbox-webpack-plugin": "^7.4.0"
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=11.6.0"
  },
  "cacheDirectories": [
    "node_modules"
  ]
}
