{
  "name": "x-road-client-101",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-rounded": "^5.3.5",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@vee-validate/rules": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22 <=24",
    "pnpm": ">=12"
  }
